<!doctype html>
<html lang="en" class="h-full bg-slate-50 antialiased">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>UniPath Thailand · สำรวจหลักสูตรมหาวิทยาลัยไทย</title>

  <script src="/static/app.js" defer></script>
  <!-- Fonts: Plus Jakarta Sans for Latin + Noto Sans Thai / Sarabun for Thai script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              200: '#bae0fd',
              500: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0b426b',
              950: '#082f4d',
            },
            accent: {
              50: '#fffbeb',
              100: '#fef3c7',
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '"Sarabun"', 'sans-serif'],
            thai: ['"Sarabun"', 'sans-serif'],
          }
        }
      }
    }
  </script>
  
  <!-- Custom Styling for Interactive States & Chip Selectors -->
  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Sarabun', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    
    /* Interest tag checkbox styling */
    .interest-checkbox:checked + .interest-chip {
      background-color: #0b426b;
      color: #ffffff;
      border-color: #0b426b;
      box-shadow: 0 4px 12px rgba(11, 66, 107, 0.18);
    }
    .interest-checkbox:checked + .interest-chip svg.check-icon {
      opacity: 1;
      transform: scale(1);
    }
    .interest-checkbox:not(:checked) + .interest-chip svg.check-icon {
      opacity: 0;
      transform: scale(0.6);
      width: 0;
      margin-right: 0;
    }
    
    /* Subtle custom scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="min-h-full flex flex-col text-slate-800 bg-slate-50 selection:bg-brand-100 selection:text-brand-900">

  <!-- Top Navigation Header with Thai University Context -->
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <!-- Logo Emblem -->
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-900 to-brand-700 flex items-center justify-center text-white shadow-md shadow-brand-900/20">
          <svg class="w-5 h-5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-brand-900 text-lg tracking-tight">UniPath</span>
            <span class="px-2 py-0.5 text-[10px] font-bold tracking-wider uppercase bg-brand-50 text-brand-700 rounded-md border border-brand-200">Thailand</span>
          </div>
          <p class="text-xs text-slate-500 font-thai leading-none mt-0.5">ระบบสำรวจหลักสูตรมหาวิทยาลัยไทย</p>
        </div>
      </div>
      
      <!-- Right Quick Actions -->
      <div class="flex items-center gap-3">
        <a href="/portfolio" class="inline-flex items-center gap-2 text-xs md:text-sm font-semibold text-brand-800 bg-brand-50 hover:bg-brand-100/80 px-3.5 py-2 rounded-lg border border-brand-200 transition-colors">
          <svg class="w-4 h-4 text-brand-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="hidden sm:inline">Portfolio PDF / เริ่มจากแฟ้มผลงาน</span>
          <span class="sm:hidden">PDF Portfolio</span>
        </a>
        <a href="https://mytcas.com/" target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-brand-900 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">
          <span>MyTCAS Official</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Hero / Intro Section with Modern Academic Aesthetics -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold uppercase tracking-wider mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>PYTHON · THAI UNIVERSITY EXPLORER</span>
      </div>
      
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight sm:leading-none">
        Find a path <span class="bg-gradient-to-r from-brand-900 via-brand-700 to-sky-600 bg-clip-text text-transparent">worth exploring.</span>
      </h1>
      
      <p class="mt-3 text-lg md:text-xl font-medium text-brand-900 font-thai">
        ค้นหาเส้นทางมหาวิทยาลัยจากความสนใจและความถนัดของคุณ
      </p>
      <p class="mt-2 text-sm md:text-base text-slate-600 leading-relaxed">
        Explore Thai university programmes by interest. Matches describe shared curriculum interests, not admission probability or guaranteed slots.
      </p>
    </div>

    <!-- Alert / Skeleton Notice Card (as requested in original html) -->
    <aside class="notice mb-8 p-4 md:p-5 rounded-2xl bg-amber-50/80 border border-amber-200/90 shadow-sm flex items-start gap-3.5" role="status">
      <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center mt-0.5">
        <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="text-sm">
        <strong class="font-bold text-amber-900 block sm:inline">Student skeleton / โครงงานเริ่มต้น</strong>
        <p class="text-amber-800 mt-1 text-xs md:text-sm leading-relaxed">
          Complete the TODOs (see <code class="px-1.5 py-0.5 bg-amber-200/50 rounded font-mono text-xs text-amber-950">TASKS.md</code>). Until then, searches will not give meaningful matches. / เติม TODO ให้ครบก่อน ผลจากโครงเริ่มต้นยังไม่ใช่คำแนะนำ
        </p>
      </div>
    </aside>

    <!-- The Contract Form (Preserves exact IDs, names, action, method) -->
    <form id="finder-form" method="get" action="/api/programmes" class="bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/50 overflow-hidden mb-12 transition-all">
      
      <!-- Top header bar in form -->
      <div class="px-6 py-5 bg-gradient-to-r from-slate-50 to-brand-50/30 border-b border-slate-200/80 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-brand-900 text-white flex items-center justify-center text-sm font-bold">1</div>
          <div>
            <h2 class="text-base font-bold text-slate-900">Your Interests / ความสนใจ</h2>
            <p class="text-xs text-slate-500">Select one or more topics that spark your passion</p>
          </div>
        </div>
        <span class="text-xs font-medium text-slate-500 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-sm">
          14 Academic Fields
        </span>
      </div>

      <!-- Fieldset: Interest Grid -->
      <fieldset class="p-6 sm:p-8">
        <legend class="sr-only">Your interests / ความสนใจ</legend>
        
        <div class="interest-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          
          <!-- Technology -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="technology" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">💻</span>
                <span>Technology / เทคโนโลยี</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Design -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interests" value="design" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🎨</span>
                <span>Design / การออกแบบ</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Games -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interests" value="games" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🎮</span>
                <span>Games / เกม</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Business -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="business" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">📈</span>
                <span>Business / ธุรกิจ</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Data -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="data" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">📊</span>
                <span>Data & numbers / ข้อมูล</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Science -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="science" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🔬</span>
                <span>Science / วิทยาศาสตร์</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Food -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="food" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🍲</span>
                <span>Food / อาหาร</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- People -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="people" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🤝</span>
                <span>People / ผู้คน</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Society -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="society" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🏛️</span>
                <span>Society / สังคม</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Communication -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="communication" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🎙️</span>
                <span>Communication / การสื่อสาร</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Environment -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="environment" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🌿</span>
                <span>Environment / สิ่งแวดล้อม</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Health -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="health" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🩺</span>
                <span>Health & care / สุขภาพ</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Education -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="education" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">📚</span>
                <span>Teaching / การสอน</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

          <!-- Arts -->
          <label class="relative flex items-center cursor-pointer group">
            <input type="checkbox" name="interest_tags" value="arts" class="interest-checkbox sr-only">
            <div class="interest-chip w-full flex items-center justify-between px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-brand-500/50 text-slate-700 text-xs sm:text-sm font-medium transition-all duration-200 select-none shadow-sm">
              <span class="flex items-center gap-2">
                <span class="text-base">🎭</span>
                <span>Arts & drama / ศิลปะ</span>
              </span>
              <svg class="check-icon w-4 h-4 text-white transition-all duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            </div>
          </label>

        </div>
      </fieldset>

      <!-- Second Section: Filters & Options -->
      <div class="border-t border-slate-100 bg-slate-50/70 p-6 sm:p-8">
        <div class="flex items-center gap-2.5 mb-5">
          <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center text-sm font-bold">2</div>
          <div>
            <h3 class="text-base font-bold text-slate-900">Geographic & Language Preferences / เงื่อนไขเพิ่มเติม</h3>
            <p class="text-xs text-slate-500">Refine by university location and instruction language</p>
          </div>
        </div>

        <div class="filters grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
          
          <!-- Region Select -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600">
              Region / ภูมิภาค
            </label>
            <div class="relative">
              <select name="region" class="w-full appearance-none bg-white text-slate-800 text-sm font-medium rounded-xl border border-slate-300 py-3 pl-4 pr-10 hover:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-700 transition-colors shadow-sm">
                <option value="any">Any / ทั้งหมด</option>
                <option value="central">Central, including Bangkok / ภาคกลาง รวมกรุงเทพฯ</option>
                <option value="north">North / ภาคเหนือ</option>
                <option value="south">South / ภาคใต้</option>
                <option value="northeast">Northeast / ภาคตะวันออกเฉียงเหนือ</option>
                <option value="east">East / ภาคตะวันออก</option>
                <option value="west">West / ภาคตะวันตก</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>

          <!-- Language Select -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600">
              Language / ภาษาที่สอน
            </label>
            <div class="relative">
              <select name="format" class="w-full appearance-none bg-white text-slate-800 text-sm font-medium rounded-xl border border-slate-300 py-3 pl-4 pr-10 hover:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-700 transition-colors shadow-sm">
                <option value="any">Any / ทั้งหมด</option>
                <option value="thai">Thai including bilingual / ไทย รวมสองภาษา</option>
                <option value="international">English including bilingual / อังกฤษ รวมสองภาษา</option>
                <option value="bilingual">Bilingual / สองภาษา</option>
                <option value="unknown">Unresolved / ยังไม่ยืนยัน</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Checkbox: Include Unresolved -->
        <div class="p-4 rounded-xl bg-white border border-slate-200/90 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
          <label class="unknown flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" name="include_unknown" value="yes" checked class="w-4 h-4 rounded text-brand-900 border-slate-300 focus:ring-brand-500">
            <span class="text-xs sm:text-sm font-semibold text-slate-800">
              Include unresolved language records / รวมรายการที่ยังไม่ยืนยันภาษา
            </span>
          </label>
          <span class="small text-[11px] text-slate-500 max-w-md sm:text-right">
            English or Thai preferences include bilingual records. Unresolved records keep their unresolved label. / ตัวกรองไทยหรืออังกฤษรวมสองภาษา ข้อมูลที่ยังไม่ยืนยันจะคงป้ายไว้
          </span>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
          <button type="submit" class="w-full sm:w-auto flex-1 inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-xl bg-gradient-to-r from-brand-900 via-brand-800 to-brand-700 hover:from-brand-950 hover:to-brand-800 text-white font-bold text-sm sm:text-base shadow-lg shadow-brand-900/25 hover:shadow-brand-900/40 transform active:scale-[0.99] transition-all">
            <svg class="w-5 h-5 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span>Find programmes / ค้นหาหลักสูตร</span>
          </button>
          
          <a class="reset w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 hover:text-slate-900 font-semibold text-sm transition-colors shadow-sm" href="/">
            Reset / เริ่มใหม่
          </a>
        </div>

      </div>
    </form>

    <!-- Results Section -->
    <section aria-labelledby="results-title" class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 mb-6 gap-2">
        <div class="flex items-center gap-3">
          <div class="w-3 h-7 bg-brand-900 rounded-full"></div>
          <h2 id="results-title" class="text-2xl font-extrabold text-slate-900">Results / ผลลัพธ์</h2>
        </div>
        <p id="status" role="status" aria-live="polite" class="text-xs sm:text-sm font-medium text-slate-500 bg-slate-100 px-3.5 py-1.5 rounded-full inline-flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span>
          <span>Choose your interests, then search. / เลือกความสนใจแล้วกดค้นหา</span>
        </p>
      </div>

      <!-- Container where app.js inserts programme cards -->
      <div id="results" class="results grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Sample preview cards shown before search or when static (simulating template injection) -->
        <article class="programme bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 hover:shadow-md transition-shadow relative flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <p class="eyebrow text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-50 px-2.5 py-1 rounded-md inline-block">Chulalongkorn University</p>
              <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">Central / Bangkok</span>
            </div>
            
            <h3 class="text-xl font-bold text-slate-900 mt-1">Computer Science & Information Technology</h3>
            <p class="text-sm font-medium text-slate-600 mt-0.5 font-thai">วิทยาการคอมพิวเตอร์ · จุฬาลงกรณ์มหาวิทยาลัย</p>
            
            <div class="flex flex-wrap items-center gap-2 my-3 text-xs text-slate-600">
              <span class="px-2 py-0.5 rounded bg-slate-100 font-medium">Bangkok</span>
              <span>·</span>
              <span class="px-2 py-0.5 rounded bg-slate-100 font-medium">Regular (4 Years)</span>
              <span>·</span>
              <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200">Bilingual (TH/EN)</span>
            </div>

            <p class="text-xs text-slate-600 line-clamp-2 mt-2 leading-relaxed">
              Focuses on software engineering, artificial intelligence, and scalable cloud systems. Strong foundation for future technologists.
            </p>
            <p class="text-xs text-slate-500 line-clamp-2 mt-1 leading-relaxed font-thai">
              เน้นวิศวกรรมซอฟต์แวร์ ปัญญาประดิษฐ์ และระบบคลาวด์ เสริมทักษะการวิเคราะห์ข้อมูลและเทคโนโลยีสมัยใหม่
            </p>

            <div class="mt-4 pt-3 border-t border-slate-100">
              <p class="text-xs text-slate-500">
                <span class="font-bold text-slate-700">Shared interests / ความสนใจที่ตรง:</span> 
                <span class="inline-flex gap-1.5 ml-1">
                  <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded text-[11px] font-medium">Technology</span>
                  <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded text-[11px] font-medium">Data</span>
                </span>
              </p>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-3 text-xs font-semibold">
            <a href="#" class="text-brand-900 hover:text-brand-700 inline-flex items-center gap-1">
              Official programme / แหล่งทางการ ↗
            </a>
            <a href="#" class="text-amber-700 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 px-2.5 py-1.5 rounded-lg border border-amber-200 inline-flex items-center gap-1 transition-colors">
              Application 2568 ↗
            </a>
          </div>
        </article>

        <!-- Second sample preview card -->
        <article class="programme bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 hover:shadow-md transition-shadow relative flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-4 mb-2">
              <p class="eyebrow text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-50 px-2.5 py-1 rounded-md inline-block">Chiang Mai University</p>
              <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">North / Chiang Mai</span>
            </div>
            
            <h3 class="text-xl font-bold text-slate-900 mt-1">Digital Game Design & Interactive Media</h3>
            <p class="text-sm font-medium text-slate-600 mt-0.5 font-thai">การออกแบบเกมดิจิทัลและสื่อปฏิสัมพันธ์ · มหาวิทยาลัยเชียงใหม่</p>
            
            <div class="flex flex-wrap items-center gap-2 my-3 text-xs text-slate-600">
              <span class="px-2 py-0.5 rounded bg-slate-100 font-medium">Chiang Mai</span>
              <span>·</span>
              <span class="px-2 py-0.5 rounded bg-slate-100 font-medium">Regular (4 Years)</span>
              <span>·</span>
              <span class="px-2 py-0.5 rounded bg-sky-50 text-sky-800 font-semibold border border-sky-200">Thai</span>
            </div>

            <p class="text-xs text-slate-600 line-clamp-2 mt-2 leading-relaxed">
              Combines creative digital storytelling, 3D art modeling, and modern game engine programming for creative industries.
            </p>
            <p class="text-xs text-slate-500 line-clamp-2 mt-1 leading-relaxed font-thai">
              ผสมผสานการเล่าเรื่องเชิงสร้างสรรค์ โมเดล 3 มิติ และการพัฒนาเกมด้วย Game Engine สำหรับอุตสาหกรรมดิจิทัลคอนเทนต์
            </p>

            <div class="mt-4 pt-3 border-t border-slate-100">
              <p class="text-xs text-slate-500">
                <span class="font-bold text-slate-700">Shared interests / ความสนใจที่ตรง:</span> 
                <span class="inline-flex gap-1.5 ml-1">
                  <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded text-[11px] font-medium">Design</span>
                  <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded text-[11px] font-medium">Games</span>
                </span>
              </p>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-3 text-xs font-semibold">
            <a href="#" class="text-brand-900 hover:text-brand-700 inline-flex items-center gap-1">
              Official programme / แหล่งทางการ ↗
            </a>
            <a href="#" class="text-amber-700 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 px-2.5 py-1.5 rounded-lg border border-amber-200 inline-flex items-center gap-1 transition-colors">
              Application 2568 ↗
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- The Exact Card Design Template Required by app.js (Full contract preserved with modern classes) -->
    <template id="card-template">
      <article class="programme bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 hover:shadow-md transition-shadow relative flex flex-col justify-between">
        <div>
          <!-- University Badge -->
          <p class="eyebrow text-xs font-bold uppercase tracking-wider text-brand-700 bg-brand-50 px-2.5 py-1 rounded-md inline-block mb-2" data-field="university_en"></p>
          
          <!-- Programme Title -->
          <h3 class="text-xl font-bold text-slate-900 leading-snug" data-field="programme_en"></h3>
          
          <!-- Thai Programme & University Subtitle -->
          <p class="text-sm font-medium text-slate-600 mt-1 font-thai">
            <span data-field="programme_th"></span> · <span data-field="university_th"></span>
          </p>
          
          <!-- Metadata Pill Badges -->
          <div class="flex flex-wrap items-center gap-2 my-3 text-xs text-slate-600">
            <span class="px-2.5 py-0.5 rounded bg-slate-100 font-medium text-slate-700" data-field="province" data-empty="Province not mapped"></span>
            <span>·</span>
            <span class="px-2.5 py-0.5 rounded bg-slate-100 font-medium text-slate-700" data-field="programme_format"></span>
            <span>·</span>
            <span class="px-2.5 py-0.5 rounded bg-brand-50 text-brand-800 font-semibold border border-brand-100" data-field="teaching_language"></span>
          </div>

          <!-- Notice when language is unresolved -->
          <p class="notice small text-xs text-amber-800 bg-amber-50 border border-amber-200 p-2.5 rounded-lg my-2 font-medium" data-show="teaching_language:unknown">
            ⚠️ Language unresolved / ยังไม่ยืนยันภาษา — inclusion is not a confirmed language match.
          </p>

          <!-- Summaries -->
          <p class="text-xs text-slate-600 mt-2 leading-relaxed" data-field="summary_en"></p>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed font-thai" data-field="summary_th"></p>

          <!-- Matched Interests & Data notes -->
          <div class="mt-4 pt-3 border-t border-slate-100 space-y-1.5">
            <p class="text-xs text-slate-600">
              <span class="font-bold text-slate-800">Shared interests / ความสนใจที่ตรง:</span> 
              <span class="text-amber-800 font-medium bg-amber-50 px-2 py-0.5 rounded border border-amber-200" data-field="matched_interests" data-empty="No interest filter selected / ไม่ได้จำกัดความสนใจ"></span>
            </p>
            <p class="small text-[11px] text-slate-400 italic" data-field="data_notes"></p>
          </div>
        </div>

        <!-- Links Footer -->
        <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs font-semibold">
          <a data-link="programme_url" target="_blank" rel="noopener noreferrer" class="text-brand-900 hover:text-brand-700 inline-flex items-center gap-1.5 hover:underline">
            <span>Official programme / แหล่งทางการ</span>
            <span>↗</span>
          </a>
          <a data-link="admission_url" target="_blank" rel="noopener noreferrer" class="text-amber-800 hover:text-amber-900 bg-amber-50 hover:bg-amber-100 px-3 py-1.5 rounded-lg border border-amber-200/90 inline-flex items-center gap-1.5 transition-colors">
            <span>Application reference / อ้างอิงการสมัคร</span>
            <span data-field="admission_reference_year_be"></span>
            <span>↗</span>
          </a>
        </div>
      </article>
    </template>

    <!-- Footer Information -->
    <footer class="mt-12 pt-8 border-t border-slate-200 text-xs text-slate-500 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="max-w-2xl leading-relaxed text-center md:text-left font-thai">
        The built-in sample has 16 curated public-university programmes in central, northern and southern Thailand. An optional MyTCAS classroom pack covers many more. Interest tags and summaries are teaching suggestions. / ตัวอย่างในโครงงานมี 16 หลักสูตรที่คัดเลือก ชุด MyTCAS เพิ่มเติมครอบคลุมมากขึ้น แท็กและคำสรุปเป็นข้อเสนอการสอน
      </p>
      <a href="https://mytcas.com/" target="_blank" rel="noopener noreferrer" class="flex-shrink-0 inline-flex items-center gap-1.5 font-bold text-brand-900 hover:text-brand-700 bg-white px-4 py-2 rounded-xl border border-slate-200 shadow-sm transition-all hover:shadow">
        <span>Official MyTCAS reference</span>
        <span class="text-amber-600">↗</span>
      </a>
    </footer>

  </main>
</body>
</html>